# Ignore markdown files by default, but allow project documentation
*.md
**/*.md
!README.md
!CONTRIBUTING.md
!CHANGELOG.md
!Walkthroughs/**/*.md
!project-docs/**/*.md
!Implementation Plan/**/*.md

# Ignore template HTML files
template.html
**/template.html

# Standard node/pnpm ignore patterns
node_modules/
**/node_modules/

# Ignore compiled/build outputs
dist/
**/dist/
build/
**/build/
.next/
**/.next/
storybook-static/
**/storybook-static/
*.log
*.mjs.gz

# Ignore local environment variables and system files
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
.DS_Store
Thumbs.db
.idea/
.vscode/
